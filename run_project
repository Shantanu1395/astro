#!/bin/bash

# 🌟 Vedic Astrology Prediction System - Complete Setup & Run Guide 🌟
# =====================================================================

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to print colored output
print_header() {
    echo -e "${PURPLE}🌟 $1 🌟${NC}"
    echo -e "${PURPLE}$(printf '=%.0s' {1..60})${NC}"
}

print_step() {
    echo -e "${CYAN}📋 $1${NC}"
}

print_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

print_error() {
    echo -e "${RED}❌ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

# Main header
clear
print_header "VEDIC ASTROLOGY PREDICTION SYSTEM"
echo ""
print_info "Complete setup and deployment guide for the astrology API"
echo ""

# Check if we're in the right directory
if [ ! -f "requirements.txt" ] || [ ! -f "src/api/main.py" ]; then
    print_error "Please run this script from the project root directory"
    print_info "Expected files: requirements.txt, src/api/main.py"
    exit 1
fi

print_success "✓ Project structure validated"
echo ""

# ============================================================================
print_header "STEP 1: ENVIRONMENT SETUP"
echo ""

print_step "1.1 Python Virtual Environment Setup"
echo ""
echo "# Create and activate virtual environment:"
echo "python3 -m venv venv_astrology"
echo "source venv_astrology/bin/activate  # On macOS/Linux"
echo "# venv_astrology\\Scripts\\activate  # On Windows"
echo ""

print_step "1.2 Install Dependencies"
echo ""
echo "# Install all required packages:"
echo "pip install --upgrade pip"
echo "pip install -r requirements.txt"
echo ""

print_step "1.3 Environment Variables"
echo ""
if [ -f ".env" ]; then
    print_success "✓ .env file exists"
    echo ""
    echo "Current configuration:"
    echo "$(cat .env | grep -E '^[A-Z]' | head -5)"
    echo ""
else
    print_warning "⚠️  .env file not found"
    echo ""
    echo "Create .env file with:"
    echo "LLM_PROVIDER=ollama"
    echo "OPENAI_API_KEY=your_key_here"
    echo "OLLAMA_URL=http://localhost:11434/api/generate"
    echo "DEBUG=true"
    echo ""
fi

# ============================================================================
print_header "STEP 2: SYSTEM REQUIREMENTS"
echo ""

print_step "2.1 Required Services"
echo ""
echo "For LLM functionality, you need ONE of the following:"
echo ""
echo "🔹 Option A: Ollama (Recommended - Free & Local)"
echo "   # Install Ollama: https://ollama.ai"
echo "   ollama pull codestral"
echo "   ollama serve  # Runs on http://localhost:11434"
echo ""
echo "🔹 Option B: OpenAI API"
echo "   # Set OPENAI_API_KEY in .env file"
echo "   # Set LLM_PROVIDER=openai in .env"
echo ""
echo "🔹 Option C: Fallback Mode (No LLM)"
echo "   # Set LLM_PROVIDER=fallback in .env"
echo "   # Uses pre-computed responses"
echo ""

print_step "2.2 System Dependencies"
echo ""
echo "✓ Python 3.8+ (for async/await support)"
echo "✓ Swiss Ephemeris (included in pyswisseph)"
echo "✓ Internet connection (for geocoding)"
echo ""

